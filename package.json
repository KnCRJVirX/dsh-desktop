{
  "name": "dsh-desktop",
  "version": "0.1.7",
  "description": "Desktop wrapper for the DeepSeek Harness (DSH) Web GUI.",
  "author": "DSH Desktop",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "node scripts/smoke.js",
    "icon": "node scripts/build-icon.cjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "^0.1.6-alpha.1",
    "@deepseek-ai/cordis-plugin-group": "^1.0.2",
    "@deepseek-ai/dsh-anonymous-user-id": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-attachment": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-authorization": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-bash-local": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-compaction": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-fs": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-hook-protocol": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-jobs": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-output-retention": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-ptc-runtime": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-sandbox": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-sdk-protocol": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-session-persistence": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-session-query": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-session-telemetry": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-session-title-llm": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-settings": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-shell": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-spill": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-subagent-in-process-driver": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-util-time": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-util-workspace-path": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-workflow": "^0.1.6-alpha.1"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "ai.deepseek.harness.desktop",
    "productName": "DeepSeek Harness",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/node",
        "to": "node",
        "filter": [
          "node.exe"
        ]
      }
    ],
    "icon": "build/icon.png",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {
    "@google/genai@1.52.0": true,
    "electron-winstaller@5.4.0": true,
    "node-pty@1.2.0-beta.15": true,
    "protobufjs@7.6.6": true,
    "@deepseek-ai/dsh-subprocess-local@0.1.6-alpha.1": true,
    "koffi@3.3.0": true
  }
}
